{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/index.mjs",
    "dev": "node --watch --import tsx ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "deploy": "pm2 start ecosystem.config.cjs",
    "db:pull": "prisma db pull",
    "db:gen": "prisma generate",
    "db:sync": "pnpm run db:pull && pnpm run db:gen",
    "smoke": "tsx ./scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@jeetgr/fastify-forge": "^0.2.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "axios": "^1.19.0",
    "croner": "^10.0.1",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "ejs": "^6.0.1",
    "es-toolkit": "^1.50.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "html-to-text": "^10.0.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^7.9.1",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
