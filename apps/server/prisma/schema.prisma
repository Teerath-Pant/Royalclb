}

model updown_bets {
  id                    Int                   @id @default(autoincrement())
  game_id               Int
  user_id               Int
  bet_on                updown_bets_bet_on
  bet_amount            Decimal               @db.Decimal(10, 2)
  win_amount            Decimal?              @db.Decimal(10, 2)
  charge                Decimal?              @db.Decimal(10, 2)
  net_win_amount        Decimal?              @db.Decimal(10, 2)
  date_time             DateTime              @db.DateTime(0)
  result_date_time      DateTime?             @db.DateTime(0)
  status                updown_bets_status    @default(PENDING)
  updown_games          updown_games          @relation(fields: [game_id], references: [id], onDelete: Cascade, map: "fk_game")
  meddolic_user_details meddolic_user_details @relation(fields: [user_id], references: [member_id], onDelete: Cascade, map: "fk_user")

  @@index([game_id], map: "fk_game")
  @@index([user_id], map: "fk_user")
  @@map("7updown_bets")
}

